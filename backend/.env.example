NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public"

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox_emails

# Rate limiting defaults (used when a Sender doesn't override them)
MAX_EMAILS_PER_HOUR=200
MIN_DELAY_MS=2000
WORKER_CONCURRENCY=5

ETHEREAL_SMTP_HOST=smtp.ethereal.email
ETHEREAL_SMTP_PORT=587

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID (Web app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# https://api.slack.com/apps -> your app -> OAuth & Permissions
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

SESSION_SECRET=change-me-to-something-random
FRONTEND_URL=http://localhost:3000
